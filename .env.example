# Database
# On serverless use a pooled URL here (e.g. PgBouncer/Neon pooler, add
# "?pgbouncer=true&connection_limit=1"). If you do, also add
# directUrl = env("DIRECT_URL") to prisma/schema.prisma for migrations.
DATABASE_URL="postgresql://user:password@localhost:5432/visionary?schema=public"

# NextAuth
AUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Login page: "true" shows the demo credentials on the login page
NEXT_PUBLIC_SHOW_DEMO_LOGINS="false"
