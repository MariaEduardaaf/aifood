# Database (Postgres). On Railway/Fly use the URL the Postgres service gives you.
DATABASE_URL="postgresql://user:password@localhost:5432/aifood?schema=public"

# Auth.js signing secret (read by src/middleware.ts and Auth.js): generate with `openssl rand -base64 32`
AUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"
# Public URL of the app; Auth.js uses it for login redirects (recommended in production)
AUTH_URL="http://localhost:3000"
# Optional: the app already sets trustHost (it runs behind a proxy). Harmless to keep
AUTH_TRUST_HOST="true"

# Public URL, used in table QR codes. NEXT_PUBLIC_* values are baked in at build
# time, so in Docker pass them as build args.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Menu photos are stored on local disk by default. Optional: folder for them
# (default <project>/uploads; the Docker image uses /app/uploads, mount a volume there)
# UPLOAD_DIR="/var/lib/aifood/uploads"

# Optional: set all three to store menu photos on Cloudinary instead of local disk
# Cloudinary cloud name (menu photo uploads)
# CLOUDINARY_CLOUD_NAME="your-cloud-name"
# Cloudinary API key (menu photo uploads)
# CLOUDINARY_API_KEY="your-api-key"
# Cloudinary API secret (menu photo uploads, server side only)
# CLOUDINARY_API_SECRET="your-api-secret"

# Login page: "true" shows the demo credentials on the login page (build time; keep "false" in production)
NEXT_PUBLIC_SHOW_DEMO_LOGINS="false"
