generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  WAITER
  ADMIN
  MANAGER
  KITCHEN
}

enum CallType {
  CALL_WAITER
  REQUEST_BILL
}

enum CallStatus {
  OPEN
  RESOLVED
}

model Restaurant {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  domain     String?  @unique
  active     Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  users      User[]
  tables     Table[]
  calls      Call[]
  orders     Order[]
  categories Category[]
  menuItems  MenuItem[]
  ratings    Rating[]
  settings   Settings?
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password_hash String
  name          String
  role          Role
  active        Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  restaurant_id String

  restaurant      Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  resolved_calls   Call[]  @relation("ResolvedBy")
  confirmed_orders Order[] @relation("ConfirmedBy")
  prepared_orders  Order[] @relation("PreparedBy")

  @@index([restaurant_id])
}

model Table {
  id         String   @id @default(cuid())
  label      String
  qr_token   String   @unique @default(cuid())
  active     Boolean  @default(true)
  created_at DateTime @default(now())
  restaurant_id String

  restaurant Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  calls  Call[]
  orders Order[]

  @@index([restaurant_id])
}

model Call {
  id          String     @id @default(cuid())
  table_id    String
  type        CallType
  status      CallStatus @default(OPEN)
  created_at  DateTime   @default(now())
  resolved_at DateTime?
  resolved_by String?
  restaurant_id String

  table    Table  @relation(fields: [table_id], references: [id], onDelete: Cascade)
  resolver User?  @relation("ResolvedBy", fields: [resolved_by], references: [id])
  rating   Rating?
  restaurant Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([table_id])
  @@index([created_at])
  @@index([restaurant_id])
}

model Rating {
  id                String   @id @default(cuid())
  call_id           String   @unique
  stars             Int      // 1-5
  feedback          String?  // comment when the rating is low
  redirected_google Boolean  @default(false) // was redirected to Google?
  created_at        DateTime @default(now())
  restaurant_id     String

  call Call @relation(fields: [call_id], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)

  @@index([stars])
  @@index([created_at])
  @@index([restaurant_id])
}

model Settings {
  id                  String  @id @default(cuid())
  restaurant_id       String  @unique
  google_reviews_url  String? // Restaurant's Google Reviews URL
  google_reviews_enabled Boolean @default(true)
  min_stars_redirect  Int     @default(4) // minimum stars to redirect

  restaurant Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
}

// ============ PHASE 2: DIGITAL MENU ============

model Category {
  id         String   @id @default(cuid())
  restaurant_id String
  name_pt    String
  name_es    String
  name_en    String
  order      Int      @default(0)
  active     Boolean  @default(true)
  created_at DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  items MenuItem[]

  @@index([order])
  @@index([active])
  @@index([restaurant_id])
}

model MenuItem {
  id             String   @id @default(cuid())
  restaurant_id  String
  category_id    String
  name_pt        String
  name_es        String
  name_en        String
  description_pt String?
  description_es String?
  description_en String?
  price          Decimal  @db.Decimal(10, 2)
  image_url      String?
  active         Boolean  @default(true)
  order          Int      @default(0)
  created_at     DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  category   Category    @relation(fields: [category_id], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([category_id])
  @@index([active])
  @@index([order])
  @@index([restaurant_id])
}

// ============ PHASE 3: ORDER SYSTEM ============

enum OrderStatus {
  PENDING    // Waiting for waiter confirmation
  CONFIRMED  // Waiter confirmed, sent to preparation
  PREPARING  // Kitchen preparing (Phase 4)
  READY      // Ready for delivery (Phase 4)
  DELIVERED  // Delivered to the customer
  CANCELLED  // Cancelled
}

model Order {
  id           String      @id @default(cuid())
  restaurant_id String
  table_id     String
  status       OrderStatus @default(PENDING)
  total        Decimal     @db.Decimal(10, 2)
  notes        String?     // General order notes
  created_at   DateTime    @default(now())
  updated_at   DateTime    @updatedAt
  confirmed_at DateTime?   // When the waiter confirmed
  delivered_at DateTime?   // When it was delivered
  confirmed_by String?     // ID of the waiter who confirmed
  preparing_at DateTime?   // When the kitchen started preparing
  ready_at     DateTime?   // When it became ready
  prepared_by  String?     // ID of the cook

  restaurant Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  table     Table       @relation(fields: [table_id], references: [id], onDelete: Cascade)
  confirmer User?       @relation("ConfirmedBy", fields: [confirmed_by], references: [id])
  preparer  User?       @relation("PreparedBy", fields: [prepared_by], references: [id])
  items     OrderItem[]

  @@index([table_id])
  @@index([status])
  @@index([created_at])
  @@index([restaurant_id])
}

model OrderItem {
  id           String  @id @default(cuid())
  order_id     String
  menu_item_id String
  quantity     Int
  unit_price   Decimal @db.Decimal(10, 2) // Price at the time of the order
  notes        String? // E.g.: "no onions", "well done"

  order    Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menu_item_id], references: [id])

  @@index([order_id])
}
